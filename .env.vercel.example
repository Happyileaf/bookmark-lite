# ============================================
# Vercel 部署环境变量示例（Neon / Vercel Postgres）
# 仅作模板使用，请勿提交真实密钥
# ============================================

# ---------- 数据库（PostgreSQL）----------
# PostgreSQL 连接地址
# 应用运行时使用；走连接池（pooled / pgbouncer）
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<database>?channel_binding=require&sslmode=require"
# 迁移脚本（db:migrate:deploy / baseline）使用；作为无连接池的直连地址，可把下方平台注入的 *_UNPOOLED 值填入
DIRECT_URL="postgresql://<user>:<password>@<unpooled-host>/<database>?sslmode=require"

# 以下变量由 Vercel / Neon 数据库集成自动注入，仅作参考，应用不直接读取：
# Neon 集成
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<unpooled-host>/<database>?sslmode=require"
PGHOST="<pooled-host>"
PGHOST_UNPOOLED="<unpooled-host>"
PGUSER="<user>"
PGDATABASE="<database>"
PGPASSWORD="<password>"
# Vercel Postgres 集成
POSTGRES_URL="postgresql://<user>:<password>@<pooled-host>/<database>?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://<user>:<password>@<unpooled-host>/<database>?channel_binding=require&sslmode=require"
POSTGRES_URL_NO_SSL="postgresql://<user>:<password>@<pooled-host>/<database>"
POSTGRES_PRISMA_URL="postgresql://<user>:<password>@<pooled-host>/<database>?channel_binding=require&connect_timeout=15&sslmode=require"
POSTGRES_USER="<user>"
POSTGRES_HOST="<pooled-host>"
POSTGRES_PASSWORD="<password>"
POSTGRES_DATABASE="<database>"

# ---------- 认证（NextAuth）----------
# 会话加密密钥：生产环境必填，长度需 ≥ 32，可用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ---------- 邮件服务（Resend）----------
# API Key：在 https://resend.com/api-keys 创建；本地未配置时，验证码会直接打印在运行 `pnpm dev` 的终端
RESEND_API_KEY="<resend-api-key>"
# 发件人地址，需在 Resend 中验证域名；留空则使用 noreply@resend.dev
MAIL_FROM_ADDRESS=""

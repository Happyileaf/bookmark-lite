# ============================================
# 本地开发环境变量示例
# ============================================

# ---------- 数据库（PostgreSQL）----------
# PostgreSQL 连接地址
# 应用运行时使用；本地直接连数据库即可，无需连接池
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmark_lite?schema=public"
# 迁移脚本（db:migrate:deploy / baseline）使用；本地与 DATABASE_URL 保持一致即可
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bookmark_lite?schema=public"

# ---------- 认证（NextAuth）----------
# 会话加密密钥：生产环境必填，长度需 ≥ 32，可用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ---------- 邮件服务（Resend）----------
# API Key：在 https://resend.com/api-keys 创建；本地未配置时，验证码会直接打印在运行 `pnpm dev` 的终端
RESEND_API_KEY="<resend-api-key>"
# 发件人地址，需在 Resend 中验证域名；留空则使用 noreply@resend.dev
MAIL_FROM_ADDRESS=""
